# Ignore everything in this repo by default.
*

# Keep only the release metadata file tracked.
!stable.json
!setup.json
!v1
!v2

# Keep the GitHub Pages source and deployment workflow tracked.
!.github/
!.github/workflows/
!.github/workflows/pages.yml
!pages/
!pages/**

# Keep this file visible for commits/changes.
!.gitignore
